# Local demo only. Copy to .env and change every secret before a shared deployment.
DEBUG=true
SECRET_KEY=dev-only-change-me
DATABASE_URL=sqlite:///./ngo.db
# PostgreSQL, when the database from docker compose is already running:
# DATABASE_URL=postgresql+psycopg://ngo:ngo@localhost:5433/ngo
AUTO_SEED=true
ADMIN_EMAIL=admin@ngo.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Super Admin
CORS_ORIGINS=*
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_MINUTES=30
PASSWORD_HASH_ROUNDS=12
DEADLINE_WARNING_DAYS=7
